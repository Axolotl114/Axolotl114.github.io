---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownPanel from "@/components/common/DropdownPanel.astro";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
}

const { link, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;

const hasChildren = processedLink.children && processedLink.children.length > 0;
---

<div class:list={["dropdown-container", className]} data-dropdown>
	{hasChildren ? (
		<button 
			class="glass-surface glass-button glass-button--quiet rounded-lg h-10 font-bold px-4 pr-8 active:scale-95 dropdown-trigger relative"
			aria-expanded="false"
			aria-haspopup="true"
			data-dropdown-trigger
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
			</div>
			<Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow absolute right-2.5 top-1/2 -translate-y-1/2" />
		</button>
		<div class="dropdown-menu" data-dropdown-menu>
			<DropdownPanel class="dropdown-content">
				{processedLink.children?.map((child, index) => (
					<DropdownItem
						href={child.external ? child.url : url(child.url)}
						target={child.external ? "_blank" : undefined}
						isLast={index === (processedLink.children?.length || 0) - 1}
						class="dropdown-item focus-ring-inset h-10"
					>
						{child.icon && <Icon name={child.icon} class="text-[1.25rem] mr-3 navbar-icon" />}
						<span>{child.name}</span>
						{child.external && (
							<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
						)}
					</DropdownItem>
				))}
			</DropdownPanel>
		</div>
	) : (
		<a 
			aria-label={processedLink.name} 
			href={processedLink.external ? processedLink.url : url(processedLink.url)} 
			target={processedLink.external ? "_blank" : null}
			class="glass-surface glass-button glass-button--quiet rounded-lg h-10 font-bold px-4 active:scale-95"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
				{processedLink.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 pointer-events-none z-50;
	}

	/* 单一打开组：只由 .is-open 驱动（hover / focus / 键盘都由 JS 统一切换） */
	.dropdown-container.is-open .dropdown-menu {
		@apply pointer-events-auto;
	}

	.dropdown-container.is-open .dropdown-arrow {
		@apply rotate-180;
	}

	.dropdown-container.is-open .dropdown-content {
		opacity: 1;
		translate: 0 0;
	}

	/* 移动端隐藏下拉菜单（移动端使用全屏抽屉） */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	// 导航下拉「单一打开组」：
	// - 悬停 / 聚焦 / 点击任一下拉时，先关闭其它下拉，并广播 axo:overlay-opened
	// - 浮动面板（设置/搜索/音乐/移动抽屉）打开时广播同名事件，下拉收到后自动关闭
	// - Esc / 点击外部关闭全部；aria-expanded 始终同步
	const OVERLAY_OPENED_EVENT = "axo:overlay-opened";
	const OVERLAY_ESCAPE_EVENT = "axo:overlay-escape";
	const CONTAINER_SELECTOR = ".dropdown-container[data-dropdown]";

	type DropdownGlobal = { __axoDropdownManager?: boolean };
	const dropdownWindow = window as Window & DropdownGlobal;

	function containers(): HTMLElement[] {
		return Array.from(
			document.querySelectorAll<HTMLElement>(CONTAINER_SELECTOR),
		);
	}

	function triggerOf(container: HTMLElement): HTMLElement | null {
		return container.querySelector<HTMLElement>("[data-dropdown-trigger]");
	}

	function isOpen(container: HTMLElement): boolean {
		return container.classList.contains("is-open");
	}

	function setOpen(container: HTMLElement, open: boolean): void {
		container.classList.toggle("is-open", open);
		const trigger = triggerOf(container);
		if (trigger) trigger.setAttribute("aria-expanded", String(open));
	}

	function closeAll(except?: HTMLElement): void {
		for (const container of containers()) {
			if (container !== except && isOpen(container)) setOpen(container, false);
		}
	}

	function openContainer(container: HTMLElement): void {
		closeAll(container);
		setOpen(container, true);
		document.dispatchEvent(
			new CustomEvent(OVERLAY_OPENED_EVENT, {
				detail: { element: container, type: "dropdown" },
			}),
		);
	}

	function closeContainer(container: HTMLElement): void {
		if (isOpen(container)) setOpen(container, false);
	}

	function containerFromNode(node: EventTarget | null): HTMLElement | null {
		if (!(node instanceof Element)) return null;
		return node.closest<HTMLElement>(CONTAINER_SELECTOR);
	}

	if (!dropdownWindow.__axoDropdownManager) {
		dropdownWindow.__axoDropdownManager = true;

		document.addEventListener("pointerover", (event) => {
			const container = containerFromNode(event.target);
			if (container) {
				if (!isOpen(container)) openContainer(container);
				return;
			}
			// 指针进入面板外区域时全关（保留面板内的移动）
			if (
				event.target instanceof Element &&
				event.target.closest(".dropdown-menu")
			) {
				return;
			}
			closeAll();
		});

		document.addEventListener("pointerout", (event) => {
			const container = containerFromNode(event.target);
			if (!container) return;
			const related = (event as PointerEvent).relatedTarget;
			if (related instanceof Node && container.contains(related)) return;
			closeContainer(container);
		});

		document.addEventListener("focusin", (event) => {
			const container = containerFromNode(event.target);
			if (container) openContainer(container);
		});

		document.addEventListener("focusout", (event) => {
			const container = containerFromNode(event.target);
			if (!container) return;
			const related = (event as FocusEvent).relatedTarget;
			if (related instanceof Node && container.contains(related)) return;
			closeContainer(container);
		});

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const container = containerFromNode(target);
			if (!container) {
				closeAll();
				return;
			}
			if (target.closest("[data-dropdown-trigger]")) {
				// 键盘/触屏点击触发：保持打开（hover 已打开时不误关）
				openContainer(container);
			} else if (target.closest(".dropdown-item")) {
				closeAll();
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				const active = containers().find(isOpen);
				if (!active) return;
				event.preventDefault();
				closeContainer(active);
				triggerOf(active)?.focus();
				return;
			}

			const target = event.target;
			if (!(target instanceof Element)) return;
			const trigger = target.closest<HTMLElement>(
				"[data-dropdown-trigger]",
			);
			const container = containerFromNode(target);
			if (!container) return;

			const items = Array.from(
				container.querySelectorAll<HTMLElement>(".dropdown-item"),
			);
			const activeIndex = items.indexOf(document.activeElement as HTMLElement);

			if (trigger) {
				if (
					(event.key === "Enter" ||
						event.key === " " ||
						event.key === "ArrowDown") &&
					!isOpen(container)
				) {
					event.preventDefault();
					openContainer(container);
					if (event.key === "ArrowDown" && items.length > 0) {
						items[0].focus();
					}
				}
				return;
			}

			if (!isOpen(container) || items.length === 0) return;
			if (event.key === "ArrowDown") {
				event.preventDefault();
				items[(activeIndex + 1 + items.length) % items.length].focus();
			} else if (event.key === "ArrowUp") {
				event.preventDefault();
				items[(activeIndex - 1 + items.length) % items.length].focus();
			} else if (event.key === "Home") {
				event.preventDefault();
				items[0].focus();
			} else if (event.key === "End") {
				event.preventDefault();
				items[items.length - 1].focus();
			}
		});

		document.addEventListener(OVERLAY_OPENED_EVENT, (event) => {
			const detail = (event as CustomEvent<{ type?: string }>).detail;
			// 面板打开时关闭所有下拉；下拉自己广播的事件不清空自己
			if (!detail || detail.type !== "dropdown") closeAll();
		});

		document.addEventListener(OVERLAY_ESCAPE_EVENT, () => closeAll());
	}
</script>

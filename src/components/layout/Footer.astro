---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

// 页脚社交图标：直接复用 profileConfig.links（Bilibili / GitHub / RSS / Atom）
// 保证亮色、暗色与 Hero 模式下都有可见入口
const socialLinks = profileConfig.links.filter(
	(link) => !!link.icon && !!link.url,
);
function resolveSocialHref(value: string): string {
	return /^(https?:|mailto:)/i.test(value) ? value : url(value);
}
const isExternalLink = (value: string): boolean => /^https?:/i.test(value);

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs.readFileSync(footerHtmlPath, "utf-8");
	// 移除HTML注释
	customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
} catch (error) {
	console.warn(
		"FooterConfig.html 读取失败:",
		error instanceof Error ? error.message : String(error),
	);
}
---

<!-- 页脚：普通流位于文档末尾。site-footer 是 immersive-reading 的隐藏选择器，
     pointer-events-auto 用于覆盖首页 banner 下父级的 pointer-events: none，两者勿删 -->
<footer class="site-footer pointer-events-auto pb-4 md:pb-6">
	<div
		class="transition border-t border-black/10 dark:border-white/15 mt-10 mb-5 border-dashed mx-32"
	>
	</div>

	<div class="transition flex flex-col items-center justify-center px-6">
		{socialLinks.length > 0 && (
			<nav class="footer-social" aria-label="Social links">
				{socialLinks.map((link) => (
					<a
						class="footer-social-link"
						href={resolveSocialHref(link.url)}
						aria-label={link.name}
						title={link.name}
						rel={isExternalLink(link.url) ? "noopener noreferrer" : undefined}
						target={isExternalLink(link.url) ? "_blank" : undefined}
					>
						<Icon name={link.icon ?? ""} class="text-[1.05rem]" aria-hidden="true" />
					</a>
				))}
			</nav>
		)}
		<div class="transition text-50 text-sm text-center wrap">
			<div class="mb-2">
				{customFooterHtml && <div set:html={customFooterHtml} />}
			</div>
			<div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
				&copy; <span id="copyright-year">{currentYear}</span>
				{profileConfig.name}. All Rights Reserved.
				<span aria-hidden="true">/</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href={url("rss.xml")}>RSS</a
				>
				<span aria-hidden="true">/</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href={url("atom.xml")}>Atom</a
				>
				<span aria-hidden="true">/</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href={url("sitemap-index.xml")}>Sitemap</a
				>
			</div>
			<!--
				注意：请勿随意修改或删除 "Powered by Astro & Firefly" 部分，这是对开源项目的尊重和支持。
				需要增加底部内容时，直接编辑 src/config/FooterConfig.html 即可，不需要修改 Footer.astro。
				------
				Attention: Please do not modify or delete the "Powered by Astro & Firefly" section at will, 
				as this is a sign of respect and support for open-source projects.
				When you need to add the bottom content, 
				you can directly edit src/config/FooterConfig.html without modifying Footer.astro.
			-->
			<div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
				<span>Powered by</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href="https://astro.build">Astro</a
				>
				<span aria-hidden="true">&</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href="https://github.com/CuteLeaf/Firefly">Firefly</a
				>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-social {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin: 0.35rem 0 0.4rem;
	}

	.footer-social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--primary) 32%, transparent);
		background-color: color-mix(in srgb, var(--card-bg) 70%, transparent);
		color: var(--primary);
		text-decoration: none;
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	:global(.dark) .footer-social-link {
		background-color: color-mix(in srgb, var(--card-bg) 55%, transparent);
	}

	.footer-social-link:hover,
	.footer-social-link:focus-visible {
		color: var(--axo-ink, var(--deep-text));
		background-color: color-mix(in srgb, var(--primary) 20%, var(--card-bg));
		border-color: color-mix(in srgb, var(--primary) 60%, transparent);
		transform: translateY(-1px);
	}

	.footer-social-link:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
</style>
